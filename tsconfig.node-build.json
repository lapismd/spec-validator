{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.deno.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/platform/deno.ts",
    "src/test-setup.ts"
  ]
}
