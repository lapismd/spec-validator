{
  "name": "@lapismd/spec-validator",
  "version": "0.1.0",
  "description": "Configurable specification, Storybook-catalog, QMD, and spec-first validation CLI for LapisMD repositories.",
  "keywords": [
    "specification",
    "mdbook",
    "validation",
    "storybook",
    "qmd",
    "cli"
  ],
  "license": "MIT",
  "author": "Steve Juma <help@lapis.md>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/spec-validator.git"
  },
  "homepage": "https://github.com/lapismd/spec-validator",
  "bugs": {
    "url": "https://github.com/lapismd/spec-validator/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "bin": {
    "spec-validator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "deno": "./dist/deno/index.js",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "skill/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "deno": "2.9.5",
    "node": ">=22"
  },
  "scripts": {
    "build": "deno task build",
    "build:node": "deno task build:node",
    "prepare": "deno task build",
    "prepack": "deno task build",
    "typecheck": "deno task typecheck",
    "test": "deno task test",
    "publint": "deno task publint",
    "spec:validate": "deno task spec:validate",
    "spec:test": "deno task test",
    "spec:build": "deno task spec:build",
    "spec:serve": "deno task spec:serve",
    "spec:first": "deno task spec:first",
    "spec:check": "deno task spec:check",
    "spec:index": "deno task spec:index",
    "spec:search": "deno task spec:search",
    "spec:lint": "deno task spec:lint",
    "doctor": "deno task doctor",
    "fmt": "deno task fmt",
    "fmt:check": "deno task fmt:check"
  },
  "peerDependencies": {
    "@tobilu/qmd": "2.5.3"
  },
  "peerDependenciesMeta": {
    "@tobilu/qmd": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "^2.6.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tobilu/qmd": "2.5.3",
    "@types/node": "^22.15.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.6.2",
    "publint": "^0.3.24",
    "tsx": "^4.20.5"
  }
}
